{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://agentteams.ai/schemas/genesis/local-manifest-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "purpose", "status", "network", "token", "allocations", "sourceSha256", "rawAllocationAbi", "genesisAllocationHash", "tool", "localFixtureArtifactSha256"],
  "properties": {
    "schemaVersion": { "const": 1 }, "purpose": { "const": "local-fixture-artifact" }, "status": { "const": "test-only" },
    "network": { "type": "object", "additionalProperties": false, "required": ["kind", "chainId"], "properties": { "kind": { "const": "local-evm" }, "chainId": { "const": "31337" } } },
    "token": { "type": "object", "additionalProperties": false, "required": ["name", "symbol", "decimals", "initialSupplyBaseUnits"], "properties": { "name": { "const": "Agent Teams AI" }, "symbol": { "const": "AGTMAI" }, "decimals": { "const": 9 }, "initialSupplyBaseUnits": { "$ref": "#/$defs/uint" } } },
    "allocations": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "object", "additionalProperties": false, "required": ["id", "idBytes32", "recipient", "amountBaseUnits"], "properties": { "id": { "type": "string" }, "idBytes32": { "$ref": "#/$defs/hash" }, "recipient": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" }, "amountBaseUnits": { "$ref": "#/$defs/uint" }, "bps": { "type": "integer", "minimum": 0, "maximum": 10000 } } } },
    "sourceSha256": { "$ref": "#/$defs/hash" }, "rawAllocationAbi": { "type": "string", "pattern": "^0x(?:[0-9a-f]{2})+$" }, "genesisAllocationHash": { "$ref": "#/$defs/hash" }, "localFixtureArtifactSha256": { "$ref": "#/$defs/hash" },
    "tool": { "type": "object", "additionalProperties": false, "required": ["name", "feature", "version"], "properties": { "name": { "const": "@agent-teams/supply" }, "feature": { "const": "genesis-manifest" }, "version": { "const": "1" } } }
  }, "$defs": { "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" }, "uint": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" } }
}
