{
  "name": "@agent-teams/token-repository",
  "version": "0.0.0",
  "private": true,
  "description": "Agent Teams token, governance, transparency, and cross-chain tooling",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.24.0 <12"
  },
  "scripts": {
    "build": "tsc --build --pretty false",
    "check:changed": "agent-teams-foundation agent-workflow changed --consumer .",
    "check:fast": "agent-teams-foundation gate run fast --consumer .",
    "clean": "node scripts/clean.mjs",
    "doctor": "./dev doctor",
    "deployment:estimate:local": "node scripts/deployment/estimate-local.ts",
    "genesis:compile:local": "pnpm --filter @agent-teams/supply genesis:compile:local",
    "genesis:inspect:local": "pnpm --filter @agent-teams/supply genesis:inspect:local",
    "genesis:validate:proposal": "pnpm --filter @agent-teams/supply genesis:validate:proposal",
    "genesis:verify:local": "pnpm build && node scripts/genesis/local-evm.ts",
    "genesis:vector:check": "node scripts/check-genesis-vector.mjs",
    "foundation:assert-dev-only": "agent-teams-foundation assert-dev-only",
    "foundation:assert-registry": "agent-teams-foundation assert-registry",
    "foundation:attach": "agent-teams-foundation attach",
    "foundation:check": "agent-teams-foundation check",
    "foundation:detach": "agent-teams-foundation detach",
    "foundation:status": "agent-teams-foundation status",
    "lint": "oxlint --deny-warnings .",
    "lint:files": "oxlint --deny-warnings",
    "rollback:preflight": "node scripts/rollback/prove-slices.mjs --preflight-only",
    "rollback:prove": "node scripts/rollback/prove-slices.mjs",
    "rollback:evidence:validate": "node scripts/rollback/validate-evidence.mjs",
    "rollback:test": "node --test scripts/tests/rollback-*.test.mjs",
    "security:check": "node --test tooling/security/security.test.mjs && node scripts/security/check.mjs",
    "security:slither:test": "node --test tooling/security/slither/tests/*.test.ts",
    "security:solidity": "node tooling/security/slither/src/composition/cli.ts",
    "security:solidity:prepare-image": "node tooling/security/slither/src/composition/prepare-image.ts",
    "solana:fixture:local": "node scripts/solana/local-fixture.ts",
    "test": "pnpm build && pnpm --filter @agent-teams/token-domain test:built && pnpm --filter @agent-teams/supply test:built",
    "test:linux-parity": "node --test scripts/tests/root-entrypoint.test.mjs scripts/tests/toolchain.test.mjs scripts/tests/tooling-boundaries.test.mjs scripts/tests/workflow.test.mjs && docker compose -f compose.yaml config --quiet",
    "test:local-evm": "pnpm build && pnpm test:local-evm:built",
    "test:local-evm:built": "node --test tooling/local-evm/tests/constructor.test.ts tooling/local-evm/tests/process.test.ts tooling/local-evm/tests/rpc.test.ts tooling/local-evm/tests/safe-fs.test.ts tooling/local-evm/tests/toolchain.test.ts tooling/local-evm/tests/verifier.adversarial.test.ts tooling/local-evm/tests/verify-cli.test.ts",
    "test:local-evm:integration": "pnpm build && node --test tooling/local-evm/tests/runner.integration.test.ts",
    "test:local-solana": "node --test tooling/local-solana/tests/*.test.ts",
    "test:deployment-plan": "node --test tooling/deployment-plan/tests/*.test.ts",
    "typecheck": "tsc --build --pretty false && tsc -p tooling/local-evm/tsconfig.json --pretty false && tsc -p tooling/local-solana/tsconfig.json --pretty false && tsc -p tooling/deployment-plan/tsconfig.json --pretty false && tsc -p tooling/security/slither/tsconfig.json --pretty false",
    "check": "pnpm rollback:preflight && pnpm foundation:assert-dev-only && pnpm foundation:assert-registry && pnpm foundation:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:linux-parity && pnpm genesis:vector:check && pnpm security:check && pnpm test:local-evm:built && pnpm test:local-solana && pnpm test:deployment-plan && pnpm security:slither:test && pnpm rollback:test && pnpm rollback:prove",
    "check:release": "pnpm check && pnpm security:solidity"
  },
  "devDependencies": {
    "@agent-teams/engineering-foundation": "0.20.0",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
