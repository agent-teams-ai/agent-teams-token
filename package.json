{
  "name": "@agent-teams/token-repository",
  "version": "0.0.0",
  "private": true,
  "description": "Agent Teams token, governance, transparency, and cross-chain tooling",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.24.0 <12"
  },
  "scripts": {
    "build": "tsc --build --pretty false",
    "check:changed": "agent-teams-foundation agent-workflow changed --consumer .",
    "check:fast": "agent-teams-foundation gate run fast --consumer .",
    "clean": "node scripts/clean.mjs",
    "doctor": "node scripts/doctor.mjs",
    "genesis:compile:local": "pnpm --filter @agent-teams/supply genesis:compile:local",
    "genesis:inspect:local": "pnpm --filter @agent-teams/supply genesis:inspect:local",
    "genesis:validate:proposal": "pnpm --filter @agent-teams/supply genesis:validate:proposal",
    "foundation:assert-dev-only": "agent-teams-foundation assert-dev-only",
    "foundation:assert-registry": "agent-teams-foundation assert-registry",
    "foundation:attach": "agent-teams-foundation attach",
    "foundation:check": "agent-teams-foundation check",
    "foundation:detach": "agent-teams-foundation detach",
    "foundation:status": "agent-teams-foundation status",
    "lint": "oxlint --deny-warnings .",
    "lint:files": "oxlint --deny-warnings",
    "test": "pnpm build && pnpm --filter @agent-teams/token-domain test:built && pnpm --filter @agent-teams/supply test:built",
    "typecheck": "tsc --build --pretty false",
    "check": "pnpm foundation:assert-dev-only && pnpm foundation:assert-registry && pnpm foundation:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@agent-teams/engineering-foundation": "0.20.0",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
