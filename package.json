{
  "name": "@agent-teams/token-repository",
  "version": "0.0.0",
  "private": true,
  "description": "Agent Teams token, governance, transparency, and cross-chain tooling",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.24.0 <12"
  },
  "scripts": {
    "build": "tsc --build --pretty false",
    "check:changed": "agent-teams-foundation agent-workflow changed --consumer .",
    "check:fast": "agent-teams-foundation gate run fast --consumer .",
    "clean": ".tools/bin/node scripts/clean.mjs",
    "doctor": "./dev doctor",
    "deployment:estimate:local": ".tools/bin/node scripts/deployment/estimate-local.ts",
    "genesis:compile:local": "pnpm --filter @agent-teams/supply genesis:compile:local",
    "genesis:inspect:local": "pnpm --filter @agent-teams/supply genesis:inspect:local",
    "genesis:validate:proposal": "pnpm --filter @agent-teams/supply genesis:validate:proposal",
    "genesis:verify:local": "pnpm build && .tools/bin/node scripts/genesis/local-evm.ts",
    "genesis:vector:check": ".tools/bin/node scripts/check-genesis-vector.mjs",
    "foundation:assert-dev-only": "agent-teams-foundation assert-dev-only",
    "foundation:assert-registry": "agent-teams-foundation assert-registry",
    "foundation:attach": "agent-teams-foundation attach",
    "foundation:check": "agent-teams-foundation check",
    "foundation:detach": "agent-teams-foundation detach",
    "foundation:status": "agent-teams-foundation status",
    "lint": "oxlint --deny-warnings .",
    "lint:files": "oxlint --deny-warnings",
    "rollback:preflight": ".tools/bin/node scripts/rollback/prove-slices.mjs --preflight-only",
    "rollback:prove": ".tools/bin/node scripts/rollback/prove-slices.mjs",
    "rollback:evidence:validate": ".tools/bin/node scripts/rollback/validate-evidence.mjs",
    "rollback:test": ".tools/bin/node --test scripts/tests/rollback-*.test.mjs",
    "security:check": ".tools/bin/node --test tooling/security/security.test.mjs && .tools/bin/node scripts/security/check.mjs",
    "security:slither:test": ".tools/bin/node --test tooling/security/slither/tests/*.test.ts",
    "security:solidity": ".tools/bin/node tooling/security/slither/src/composition/cli.ts",
    "security:solidity:prepare-image": ".tools/bin/node tooling/security/slither/src/composition/prepare-image.ts",
    "solana:fixture:local": ".tools/bin/node scripts/solana/local-fixture.ts",
    "test": "pnpm build && pnpm --filter @agent-teams/token-domain test:built && pnpm --filter @agent-teams/supply test:built",
    "test:linux-parity": ".tools/bin/node --test scripts/tests/root-entrypoint.test.mjs scripts/tests/toolchain.test.mjs scripts/tests/toolchain-archive-finalization.test.mjs scripts/tests/toolchain-hardening.test.mjs scripts/tests/toolchain-publication-transaction.test.mjs scripts/tests/tooling-boundaries.test.mjs scripts/tests/workflow.test.mjs && docker compose -f compose.yaml config --quiet",
    "test:local-evm": "pnpm build && pnpm test:local-evm:built",
    "test:local-evm:built": ".tools/bin/node --test tooling/local-evm/tests/cleanup.test.ts tooling/local-evm/tests/lease-concurrency.test.ts tooling/local-evm/tests/lease-initialization.test.ts tooling/local-evm/tests/lease-deletion.test.ts tooling/local-evm/tests/constructor.test.ts tooling/local-evm/tests/process.test.ts tooling/local-evm/tests/rpc.test.ts tooling/local-evm/tests/safe-fs.test.ts tooling/local-evm/tests/toolchain.test.ts tooling/local-evm/tests/verifier.adversarial.test.ts tooling/local-evm/tests/verify-cli.test.ts",
    "test:local-evm:integration": "pnpm build && .tools/bin/node --test tooling/local-evm/tests/runner.integration.test.ts",
    "test:local-solana": ".tools/bin/node --test tooling/local-solana/tests/*.test.ts",
    "test:deployment-plan": ".tools/bin/node --test tooling/deployment-plan/tests/*.test.ts",
    "typecheck": "tsc --build --pretty false && tsc -p tooling/local-evm/tsconfig.json --pretty false && tsc -p tooling/local-solana/tsconfig.json --pretty false && tsc -p tooling/deployment-plan/tsconfig.json --pretty false && tsc -p tooling/security/slither/tsconfig.json --pretty false && tsc -p tooling/testnet-ccip/tsconfig.json --pretty false",
    "check": "pnpm docs:protocol:check && pnpm foundation:assert-dev-only && pnpm foundation:assert-registry && pnpm foundation:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:linux-parity && pnpm genesis:vector:check && pnpm security:check && pnpm test:local-evm:built && pnpm test:local-solana && pnpm test:deployment-plan && pnpm security:slither:test && pnpm test:testnet-ccip && pnpm rollback:test",
    "check:linux": "pnpm rollback:preflight && pnpm check && pnpm rollback:prove",
    "check:release": "pnpm check && pnpm security:solidity",
    "test:testnet-ccip": ".tools/bin/node --test tooling/testnet-ccip/tests/*.test.ts tooling/testnet-ccip/tests/solana-registration-composition.test.mjs tooling/testnet-ccip/tests/evm-forward.test.mjs tooling/testnet-ccip/tests/solana-pool-config-composition.test.mjs tooling/testnet-ccip/tests/solana-reverse.test.mjs tooling/testnet-ccip/tests/transfer-status.test.mjs tooling/testnet-ccip/tests/transfer-status-rpc.test.mjs tooling/testnet-ccip/tests/solana-manual-execution.test.mjs tooling/testnet-ccip/tests/solana-manual-execution-state.test.mjs",
    "docs:check": "agent-teams-docs check --consumer . --profile architecture/foundation/docs-protocol.yaml",
    "docs:doctor": "agent-teams-docs doctor --consumer . --profile architecture/foundation/docs-protocol.yaml",
    "docs:find": "agent-teams-docs find --consumer . --profile architecture/foundation/docs-protocol.yaml",
    "docs:info": "agent-teams-docs info --consumer . --profile architecture/foundation/docs-protocol.yaml",
    "docs:new": "agent-teams-docs new --consumer . --profile architecture/foundation/docs-protocol.yaml",
    "docs:recover": "agent-teams-docs recover --consumer . --profile architecture/foundation/docs-protocol.yaml",
    "docs:protocol:check": "pnpm docs:check",
    "deployment:config": "pnpm build && .tools/bin/node packages/contexts/supply/dist/features/genesis-manifest/composition/cli.js deployment",
    "deployment:readiness": ".tools/bin/node tooling/deployment-plan/src/composition/readiness.ts",
    "token:passport": "pnpm build && .tools/bin/node packages/contexts/supply/dist/features/genesis-manifest/composition/passport-cli.ts",
    "custody:testnet": ".tools/bin/node tooling/testnet-ccip/src/composition/custody-cli.ts",
    "custody:verify": ".tools/bin/node tooling/testnet-ccip/src/composition/custody-verify.ts",
    "test:custody:local": ".tools/bin/node --test tooling/testnet-ccip/tests/custody-*.test.ts"
  },
  "devDependencies": {
    "@agent-teams/docs-protocol": "0.6.0",
    "@agent-teams/docs-protocol-agent-teams": "0.2.7",
    "@agent-teams/engineering-foundation": "1.2.0",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "@agent-teams/supply": "workspace:*",
    "@noble/hashes": "catalog:"
  }
}
