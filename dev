#!/usr/bin/env bash
set -euo pipefail

token_repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
token_command=${1:-help}
shift || true

# Bootstrap and doctor deliberately run before project-local directories are
# added to PATH. Offline install therefore validates/replaces a present install
# without executing binaries from that install first.
case "$token_command" in
  bootstrap)
    exec "$token_repo_root/scripts/bootstrap.sh" "$@"
    ;;
  doctor)
    exec node "$token_repo_root/scripts/doctor.mjs" "$@"
    ;;
esac

source "$token_repo_root/scripts/env.sh"

case "$token_command" in
  check)
    exec pnpm check "$@"
    ;;
  evm-up)
    exec docker compose -f "$token_repo_root/compose.yaml" up -d --wait anvil
    ;;
  evm-down)
    exec docker compose -f "$token_repo_root/compose.yaml" down
    ;;
  solana)
    mkdir -p "$token_repo_root/.local/solana-ledger"
    exec solana-test-validator \
      --reset \
      --ledger "$token_repo_root/.local/solana-ledger" \
      --rpc-port 8899 \
      --faucet-port 9900 \
      "$@"
    ;;
  help|*)
    printf '%s\n' \
      'Usage: ./dev <command>' \
      '  bootstrap  Fetch/install pinned darwin-arm64 or linux-x64 tools' \
      '  doctor     Verify versions, checksums, platform and network guard' \
      '  check      Run lint, typecheck, and unit tests' \
      '  evm-up     Start the local Anvil container' \
      '  evm-down   Stop local containers' \
      '  solana     Start native solana-test-validator'
    ;;
esac
