#!/bin/bash
set -euo pipefail

token_dev_source=${BASH_SOURCE[0]}
if [[ "$token_dev_source" == */* ]]; then
  token_dev_directory=${token_dev_source%/*}
  [[ -n "$token_dev_directory" ]] || token_dev_directory=/
else
  token_dev_directory=.
fi
token_repo_root=$(CDPATH= cd -- "$token_dev_directory" && pwd -P)
token_command=${1:-help}
if (($# > 0)); then
  shift
fi

# Bootstrap recovery and inert help do not require a previously trusted install.
# Doctor delegates to bootstrap so both offline verification and the diagnostic
# execute through Node extracted from the checksum-pinned archive.
case "$token_command" in
  bootstrap)
    exec "$token_repo_root/scripts/bootstrap.sh" "$@"
    ;;
  doctor)
    exec "$token_repo_root/scripts/bootstrap.sh" doctor "$@"
    ;;
  help)
    ;;
  check|evm-up|evm-down|solana)
    ;;
  *)
    token_command=help
    ;;
esac

# Every tool-executing root command fails closed on archive-backed offline
# verification before env.sh can add installed candidates to PATH.
case "$token_command" in
  check|evm-up|evm-down)
    "$token_repo_root/scripts/bootstrap.sh" verify --offline
    ;;
  solana)
    "$token_repo_root/scripts/bootstrap.sh" verify --offline --scope=solana
    ;;
esac

if [[ "$token_command" != help ]]; then
  source "$token_repo_root/scripts/env.sh"
fi

case "$token_command" in
  check)
    exec "$token_repo_root/.tools/bin/pnpm" check "$@"
    ;;
  evm-up)
    exec docker compose -f "$token_repo_root/compose.yaml" up -d --wait anvil
    ;;
  evm-down)
    exec docker compose -f "$token_repo_root/compose.yaml" down
    ;;
  solana)
    /bin/mkdir -p "$token_repo_root/.local/solana-ledger"
    exec solana-test-validator \
      --reset \
      --ledger "$token_repo_root/.local/solana-ledger" \
      --rpc-port 8899 \
      --faucet-port 9900 \
      "$@"
    ;;
  help)
    printf '%s\n' \
      'Usage: ./dev <command>' \
      '  bootstrap  Fetch/install pinned darwin-arm64 or linux-x64 tools' \
      '  doctor     Verify versions, checksums, platform and network guard' \
      '  check      Run lint, typecheck, and unit tests' \
      '  evm-up     Start the local Anvil container' \
      '  evm-down   Stop local containers' \
      '  solana     Start native solana-test-validator'
    ;;
esac
